# Server Configuration
PORT=3001
NODE_ENV=production

# Server-side keys below are only used for requests that send X-App-Token
# matching this value. Leave empty to require callers to bring their own keys.
SERVER_KEYS_ACCESS_TOKEN=

# AI Provider API Keys (Optional - can use BYOK via headers)
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
OLLAMA_BASE_URL=http://localhost:11434

# Search API Keys (Optional)
BRAVE_SEARCH_API_KEY=your_brave_search_key_here
GITHUB_TOKEN=your_github_token_here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Maximum mentions sent for AI analysis per search
MAX_ANALYZED_MENTIONS=20

# Cache Settings
CACHE_TTL_SECONDS=3600
