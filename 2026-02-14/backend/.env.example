# API Keys (optional - users can provide via headers)
# Server keys are only used for requests that send PAPERPLAIN_ACCESS_TOKEN
# as `Authorization: Bearer <token>` or `X-Access-Token`.
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
PAPERPLAIN_ACCESS_TOKEN=

# Abuse limits
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=20
MAX_UPLOAD_BYTES=10485760
MAX_TEXT_LENGTH=50000
# Set (e.g. to 1) only when running behind a trusted reverse proxy
TRUST_PROXY=

# Server Configuration
PORT=3108
NODE_ENV=production

# Logging
LOG_LEVEL=info
